<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS%20Files/ScreenUI.uss?fileID=7433441132597879392&amp;guid=b3cf03a402517934d98aa5be205e07dd&amp;type=3#ScreenUI"/>
    <ui:VisualElement name="GameUIContainer" style="flex-grow: 1; display: flex;">
        <ui:VisualElement name="UpContainer" class="upContainer-play upContainer-base">
            <ui:VisualElement name="UpScreenBar" class="up-screen-bar"/>
            <ui:VisualElement name="ScoreContainer" style="flex-grow: 1; background-image: none; background-color: rgba(255, 255, 255, 0); -unity-background-image-tint-color: rgb(255, 255, 255); background-position-y: center; width: 400px; height: 100px; position: absolute; top: 150px; left: 150px; align-items: flex-start; flex-direction: column; align-self: flex-start; align-content: flex-start; justify-content: flex-start;">
                <ui:Label text="Score: 0" name="ScoreTextShadow" class="score-text-front score-text-shadow" style="width: 300px; align-items: flex-start; height: 100px; -unity-text-align: middle-left; font-size: 65px;">
                    <ui:Label text="Score: 0" name="ScoreText" class="score-text-front" style="top: -7px; width: 300px; align-items: flex-start; height: 100px; -unity-text-align: middle-left; font-size: 65px;"/>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="HealthbarContainer" style="flex-grow: 1; width: 465px; height: 90px; position: absolute; top: 20px; left: 20px; overflow: hidden; flex-wrap: nowrap; flex-direction: column; align-items: stretch; justify-content: flex-start; align-self: auto; align-content: flex-start;">
                <ui:VisualElement name="HealthbarBackground" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Background.png?fileID=2800000&amp;guid=abca15b9d9a48a7499c6c5f954a9b79f&amp;type=3#Background&quot;); overflow: hidden; width: 465px; height: 100%; -unity-background-image-tint-color: rgb(255, 0, 0);">
                    <ui:VisualElement name="HealthBarMask" style="flex-grow: 1; position: absolute; top: 0; left: 0; width: 445px; height: 100%; overflow: hidden; transform-origin: left top; display: flex;">
                        <ui:VisualElement name="HealthbarFiller_00" class="healthbar-filler-numbered">
                            <ui:VisualElement name="HealthbarFiller_01" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 59px; height: 80px; top: 0; left: 40px; scale: 1 1;">
                                <ui:VisualElement name="HealthbarFiller_02" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 59px; height: 80px; top: 0; left: 40px; scale: 1 1;">
                                    <ui:VisualElement name="HealthbarFiller_03" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 59px; height: 80px; top: 0; left: 40px; scale: 1 1;">
                                        <ui:VisualElement name="HealthbarFiller_04" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 59px; height: 80px; top: 0; left: 40px; scale: 1 1;">
                                            <ui:VisualElement name="HealthbarFiller_05" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 60px; height: 80px; top: 0; left: 40px; scale: 1 1;">
                                                <ui:VisualElement name="HealthbarFiller_06" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 59px; height: 81px; top: 0; left: 40px; scale: 1 1;">
                                                    <ui:VisualElement name="HealthbarFiller_07" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 59px; height: 80px; top: 0; left: 40px; scale: 1 1;">
                                                        <ui:VisualElement name="HealthbarFiller_08" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 59px; height: 80px; top: 0; left: 40px; scale: 1 1; display: flex;">
                                                            <ui:VisualElement name="HealthbarFiller_09" class="healthbar-filler-numbered" style="background-image: url(&quot;project://database/Assets/Sprites/UI/IndividualBarSliced.png?fileID=2800000&amp;guid=96d2ae60455175444965a9f780f1aeff&amp;type=3#IndividualBarSliced&quot;); width: 59px; height: 80px; top: 0; left: 40px; scale: 1 1; display: flex;"/>
                                                        </ui:VisualElement>
                                                    </ui:VisualElement>
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="HealthbarBorderAndInlines" style="flex-grow: 1; width: 465px; height: 90px; position: absolute; top: 20px; left: 20px; display: flex;">
                <ui:VisualElement name="HealthbarBorder" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Border.png?fileID=2800000&amp;guid=bf899b9b885eccc4bb76d754bc634559&amp;type=3#Border&quot;); width: 465px; height: 9px;">
                    <ui:VisualElement name="HealthbarInlines" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Inlines.png?fileID=2800000&amp;guid=ea59ca4458c5265478e505c85aede503&amp;type=3#Inlines&quot;); overflow: hidden; width: 465px; height: 90px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="TimerContainer" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/TimerFrame/TimerFrame.png?fileID=-4041904047743625455&amp;guid=fef635bf4ce737342a1d40b6e1d8a3df&amp;type=3#TimerFrame_0&quot;); width: 400px; height: 100px; position: absolute; left: 760px; top: 65px; background-color: rgba(255, 255, 255, 0); -unity-background-image-tint-color: rgb(255, 255, 255);">
                <ui:Label text="Time" name="TimerTextShadow" class="score-text-front timer-text-shadow" style="font-size: 65px;">
                    <ui:Label text="Time" name="TimerText" class="score-text-front timer-text-front" style="font-size: 65px;"/>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="PlayerPortrait" class="character-portrait" style="width: 120px; height: 120px;"/>
            <ui:VisualElement name="WaveTextContainer" style="flex-grow: 1; left: 1480px; top: 25px; position: absolute; width: 200px; height: 80px;">
                <ui:Label text="Wave 1" name="WaveTextLabel" style="position: relative; font-size: 65px; -unity-font-definition: url(&quot;project://database/Assets/Imports/BoldPixels/Assets/font/BoldPixels.ttf?fileID=12800000&amp;guid=71a55b0538d48354b87afab937af74d2&amp;type=3#BoldPixels&quot;); color: rgb(255, 255, 255); top: 0; left: 0;"/>
            </ui:VisualElement>
            <ui:VisualElement name="HealthbarTextContainer" class="ui-text-generic" style="height: 80px; width: 160px; top: 25px; left: 490px;">
                <ui:Label text="10 HP" name="HealthbarTextLabel"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="DownContainer" class="downContainer-play downContainer-base">
            <ui:VisualElement name="DownScreenBar" class="down-screen-bar"/>
            <ui:VisualElement name="EnemyCounterContainer" style="flex-grow: 1; flex-direction: row; position: absolute; top: 953px; left: 1023px; width: 700px; height: 120px; flex-wrap: nowrap; align-self: center; justify-content: space-between; align-items: center; align-content: flex-start; opacity: 1;">
                <ui:VisualElement name="BruteCounterPortrait" class="enemy-portrait" style="width: 130px; height: 130px; top: 0; left: 25px; flex-direction: column; align-items: stretch; justify-content: flex-start; align-self: center; position: absolute; opacity: 1;"/>
                <ui:Label text="x0" name="BruteCounterText" class="enemy-counter-text" style="font-size: 55px; position: absolute; left: 190px; color: rgb(255, 255, 255);"/>
                <ui:VisualElement name="ShooterCounterPortrait" class="enemy-portrait" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Enemies/Shooter/Shooter_Idle.png?fileID=-1919121431002057286&amp;guid=99597718f879a5e4f8b1b4b5fd91bb53&amp;type=3#Shooter_Idle_0&quot;); height: 130px; width: 130px; align-self: center; position: absolute; left: 400px; top: -5px; opacity: 1;"/>
                <ui:Label text="x0" name="ShooterCounterText" class="enemy-counter-text" style="font-size: 55px; position: absolute; left: 590px; color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:VisualElement name="EnemiesRemainingContainer" style="flex-grow: 1; position: absolute; width: 550px; height: 80px; top: 980px; left: 265px;">
                <ui:Label text="Enemies Remaining" name="EnemiesRemainingText" style="-unity-font-definition: url(&quot;project://database/Assets/Imports/BoldPixels/Assets/font/BoldPixels.ttf?fileID=12800000&amp;guid=71a55b0538d48354b87afab937af74d2&amp;type=3#BoldPixels&quot;); font-size: 60px; color: rgb(255, 255, 255); -unity-text-align: middle-center; opacity: 1; display: flex;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="MainMenuContainer" style="flex-grow: 1; width: 1920px; height: 1080px; position: absolute; top: 0; left: 0; flex-direction: column; flex-wrap: wrap; display: flex;">
        <ui:VisualElement name="MainMenuLeftUp" class="MMLU-base"/>
        <ui:VisualElement name="MainMenuLeftDown" class="MMLD-base"/>
        <ui:VisualElement name="MainMenuRightUp" class="MMRU-base"/>
        <ui:VisualElement name="MainMenuRightDown" class="MMRD-base"/>
        <ui:VisualElement name="ButtonsContainer" class="buttonsContainer-base">
            <ui:Button text="Play" name="PlayButton" class="button-specs" style="height: 100px;"/>
            <ui:Button text="Credits" name="CreditsButton" class="button-specs" style="height: 100px;"/>
            <ui:Button text="Quit" name="QuitButton" class="button-specs" style="height: 100px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Logo" class="logo-base"/>
    </ui:VisualElement>
    <ui:VisualElement name="CreditsContainer" class="creditsBase">
        <ui:VisualElement name="Background" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Imports/DEVNIK%202D/2D%20UI%20PIXEL%20BUTTONS/UI%20SIMPLE%20PIXEL%20UNSPLIT.png?fileID=482729247&amp;guid=a37e8466236089c45b610370218b5353&amp;type=3#BAR2&quot;); position: relative;"/>
        <ui:VisualElement name="CreditsTextContainer" style="flex-grow: 1; position: absolute; align-items: auto; align-self: center; top: 50px;">
            <ui:Label text="Credits" class="score-text-front" style="color: rgb(0, 0, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement name="CreditsLeft" style="flex-grow: 1; position: absolute; width: 40%; height: 65%; top: 18%; left: 5%;">
            <ui:VisualElement name="LeftTextContainer" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; top: 67%; height: 50px;">
                <ui:Label text="Autor: Cainos&#10;Coste:Gratuito&#10;Descripcion: Tileset y Bancos&#10;Enlace: https://cainos.itch.io/&#10;pixel-art-top-down-basic&#10;Modificaciones: Paleta de colores y tamaño " name="ModificationsLeft" class="timer-text-shadow" style="position: relative; font-size: 35px; -unity-text-align: middle-left; -unity-font-style: normal; height: 100px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="SpritesLeftContainer" style="flex-grow: 1; position: absolute; top: 0; width: 100%; height: 410px;">
                <ui:VisualElement name="TileSetsLeft" style="flex-grow: 1; width: 50%;">
                    <ui:Label text="Tileset" name="SpritesLeftLabel" class="timer-text-shadow" style="width: 256px;"/>
                    <ui:Label text="Props (bancos)" name="BancosLeftLabel" class="timer-text-shadow" style="width: 288px; position: absolute; left: 256px;"/>
                    <ui:VisualElement name="OldTileSetLeft" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Credits/Cainos/TX%20Tileset%20Grass.png?fileID=70345852487738077&amp;guid=840eb662392770c4db7a2a8f83b6f95e&amp;type=3#TX Tileset Grass_0&quot;); width: 256px; height: 256px; position: absolute; top: 50px; left: 0; align-self: center;"/>
                    <ui:VisualElement name="BancosLeft" style="flex-grow: 1; position: absolute; top: 50px; width: 256px; height: 256px; background-image: none; left: 270px; flex-direction: row;">
                        <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Credits/Cainos/TX%20Props.png?fileID=5149286634510447697&amp;guid=d8bc0494fbc37bc48b767bd3371f6352&amp;type=3#TX Props_7&quot;);"/>
                        <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Credits/Cainos/TX%20Props.png?fileID=6045510324929769632&amp;guid=d8bc0494fbc37bc48b767bd3371f6352&amp;type=3#TX Props_16&quot;);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CreditsRight" style="flex-grow: 1; position: absolute; width: 40%; height: 65%; top: 18%; left: 55%;">
            <ui:VisualElement name="RightTextContainer" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; top: 67%; height: 50px;">
                <ui:Label text="Autor: Anokolisa&#10;Coste:Gratuito&#10;Descripcion: Arboles&#10;Enlace: https://anokolisa.itch.io/free-pixel-art&#10;-asset-pack-topdown-tileset-rpg-16x16-sprites&#10;Modificaciones: Paleta de colores " name="ModificationsRight" class="timer-text-shadow" style="position: relative; font-size: 35px; -unity-text-align: middle-left; -unity-font-style: normal; height: 100px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="SpritesRightContainer" style="flex-grow: 1; position: absolute; top: 0; width: 100%; height: 410px; flex-direction: row;">
                <ui:Label text="Trees" name="SpritesRightLabel" class="timer-text-shadow" style="width: 680px; position: absolute;"/>
                <ui:VisualElement name="TreesSmall" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Credits/Anokolisa/Size_03.png?fileID=5903473390127743887&amp;guid=86d6a8b3ea7b4e840b47ffcef1bf24c4&amp;type=3#Size_03_0&quot;); height: 270px; top: 35px;"/>
                <ui:VisualElement name="TreesMedium" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Credits/Anokolisa/Size_04.png?fileID=-6489005286283933747&amp;guid=60be33c1eea6a0c4987e916ec1a7ed92&amp;type=3#Size_04_0&quot;); height: 270px; top: 35px;"/>
                <ui:VisualElement name="TreesBig" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/Credits/Anokolisa/Size_05.png?fileID=-1349718751397675806&amp;guid=913c12327a3ae7b449321c9cd7961967&amp;type=3#Size_05_0&quot;); height: 270px; top: 35px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="" name="ExitCredits" class="button-specs exitcredits"/>
    </ui:VisualElement>
